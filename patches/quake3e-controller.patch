+#ifdef USE_JOYSTICK
+/*
+===============
+IN_ProcessRumble
+===============
+*/
+static void IN_ProcessRumble( void )
+{
+	int low, high, duration;
+	int seq;
+
+	if ( !stick )
+		return;
+
+	low = joy_rumble_low->integer;
+	high = joy_rumble_high->integer;
+	duration = joy_rumble_duration->integer;
+
+	if ( low == 0 && high == 0 )
+		return;
+
+	seq = low + ( high << 16 ) + ( duration << 24 );
+	if ( seq == joy_rumble_last_seq )
+		return;
+	joy_rumble_last_seq = seq;
+
+	if ( SDL_JoystickRumble( stick, (Uint16)low, (Uint16)high, (Uint32)duration ) != 0 )
+	{
+		Com_DPrintf( "SDL_JoystickRumble failed: %s\n", SDL_GetError() );
+	}
+}
+#endif // USE_JOYSTICK
