+			&& state->number >= 0 && state->number < MAX_CLIENTS) {
+			clientInfo_t *nci = &cgs.clientinfo[state->number];
+			if (nci->botSkill > 0) {
+				int cl = state->constantLight;
+				qboolean boss = ((cl & 0xFF) > 200) && (((cl >> 8) & 0xFF) < 40);
